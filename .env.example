# App
# Untuk production (linky.agentbuff.id), set: https://linky.agentbuff.id
# Untuk dev lokal: http://localhost:1709
NEXT_PUBLIC_APP_URL=http://localhost:1709
NEXT_PUBLIC_APP_NAME=Linky

# Database (SQLite file untuk dev; swap ke Postgres URL untuk produksi)
DATABASE_URL=file:./linky.db

# Auth — generate string random minimal 32 karakter untuk produksi
# e.g. `openssl rand -base64 32`
AUTH_SECRET=dev-secret-change-me-in-production-please-use-strong-random-value

# Google OAuth login (WAJIB agar login berfungsi) — lihat docs/AUTH-GOOGLE-SETUP.md
# Authorized redirect URI di Google Console:
#   dev : http://localhost:1709/api/auth/oauth/google/callback
#   prod: https://linky.agentbuff.id/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Opsional) SSO / OIDC generik — "colokan" untuk IdP enterprise (Keycloak/Auth0/Azure AD/Okta).
# Diisi semua → tombol login SSO otomatis muncul. Dikosongkan → fitur mati.
# SSO_OIDC_LABEL=Perusahaan
# SSO_OIDC_AUTHORIZE_URL=
# SSO_OIDC_TOKEN_URL=
# SSO_OIDC_USERINFO_URL=
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_SCOPE=openid email profile

# Locale default
DEFAULT_LOCALE=id
