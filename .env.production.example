# Copy to .env.production on the VPS and fill in real values.
# File should be mode 600, owned by the deploy user.

# Production app URL
NEXT_PUBLIC_APP_URL=https://linky.agentbuff.id

# 32+ char random secret (generate: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth login (WAJIB) — see docs/AUTH-GOOGLE-SETUP.md
# Authorized redirect URI: https://linky.agentbuff.id/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Optional) Generic OIDC SSO — fill all to enable an enterprise SSO button:
# SSO_OIDC_LABEL=
# SSO_OIDC_AUTHORIZE_URL=
# SSO_OIDC_TOKEN_URL=
# SSO_OIDC_USERINFO_URL=
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=

# Database (PostgreSQL — REQUIRED, no SQLite fallback).
# A dedicated Postgres is provisioned on the VPS: container `linky_postgres` (postgres:18) on docker
# network `linky-net`, DB `linky`, role `linky_user`. The app container joins `linky-net` (declared
# external in docker-compose.yml) and resolves the DB by container name on the internal port 5432.
# From the host/tunnel it is also reachable at 127.0.0.1:5434.
DATABASE_URL=postgres://linky_user:PASSWORD@linky_postgres:5432/linky

# Redis (optional — degraded mode is fine for single instance)
REDIS_URL=

# Feature flags / misc
DEFAULT_LOCALE=id
